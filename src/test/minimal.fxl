#
#load "core"

load "argv"
load "basic"
load "sym"

load "bool"

load "math"
load "crypto"
load "buf"
load "cmp"
load "file"
load "istr"
load "num"
load "record"
load "str"
load "tuple"

load "list"

load "output"

evaluate \;

# Using technique for breaking a loop.
(
\\break
each (range 0 10)
	(\i
	\\loop
	\val=(argv i)
	is_undef val break;
	say ["argv "i" = "(val)]
	loop
	)
);
say "END"
