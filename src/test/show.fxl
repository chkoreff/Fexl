#
use "test.fxl"
evaluate \;

\name=(argv 2)
is_undef name (error "Missing test name");

# Test interactive script.
eq name "a2"
(
run_fexl_file name
~
abc
defg

hij
åabcüdef
üä 1≠0 包子
~
);

# Test interactive script.
eq name "get_byte"
(
run_fexl_file name
~
abcABC
jjja小
åüä≠
包子
~
);

# Run this test with minimal environment.
eq name "minimal"
(
# Quote a string to use as a shell argument.
\sh_quote=
	(
	\contains=(\x\y is_good (search x y 0))
	\x
	\x=(to_str x)
	contains x QU
		(
		# Escape all QU with "\".
		\x=(str_map (\ch eq ch QU (. "\" ch) ch) x)
		to_str [QU x QU]
		);
	contains x " " (to_str [QU x QU]);
	x
	)

\args=
	[
	"a"
	"b 2"
	"c"
	["d"" ""e"]
	~ "f"~
	~ g" "h~
	[QU QU]
	]

\prog=(. (argv 0) "0")
\args=[prog "test/minimal.fxl"; args]

# Print the shell command that would invoke this test.
\cmd=(join_list " "; map sh_quote args)

say cmd
run_exec (map to_str args) ""
);

# Run this test with minimal environment.
eq name "b54"
(
\prog=(. (argv 0) "0")
run_exec [prog "test/b54.fxl"] ""
);

# Other normal tests run here.
run_fexl_file name ""
