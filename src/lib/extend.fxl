#
load_argv
load_basic
load_cmp
load_math
load_output
load_parse
load_record
load_str
load_sym
evaluate \;

\use_context=
	(\\cx\\body
	\save=std
	set_std cx
	\x=body
	set_std save
	x
	)

\restrict=(use_context empty)

\guard=(use_context (record_copy std))

\walk_record= # LATER 20260316 built-in
	(\rec\f
	\n=(record_count rec)
	(@\\loop\i
	ge i n ();
	record_item rec i \k\\v
	f k v;
	loop (+ 1 i)
	)
	0
	)

\import_record=
	(\cx
	walk_record cx define
	)

\\make_load=
	(\\form\\predefine
	{
	(
	import_record
		(\=
		\list=
			(
			restrict;
			predefine
			evaluate form
			)

		\cx=empty
		record_fill cx list
		cx
		)
	)
	}
	)

\read_lib=
	(\name
	parse_file (. dir_lib name)
	)

\make_lib=
	(\name
	make_load (read_lib name)
	)

\\load_top=
	(
	define "evaluate" evaluate
	)

#[ Level 1
make_lib "bool.fxl"
	(
	load_basic
	)
	\\load_bool

make_lib "extra.fxl"
