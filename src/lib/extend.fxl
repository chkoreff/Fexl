	load_argv
	load_basic
	load_cmp
	load_file
	load_math
	load_output
	load_parse
	load_record
	load_run
	load_str
	load_sym
	load_top
	)
	\\load_extra

# Extend load_extra with some functions defined above.
\\load_extra=
	(
	load_extra
	define "use_context" use_context
	define "restrict" restrict
	define "guard" guard
	define "walk_record" walk_record
	define "make_load" make_load
	)

